FROM golang:1.27.3-alpine3.23 AS osv-build
RUN CGO_ENABLED=0 go install github.com/google/osv-scanner/v2/cmd/osv-scanner@v2.7.1

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --from=osv-build /go/bin/osv-scanner /usr/local/bin/osv-scanner
COPY app ./app
USER 10001:10001
EXPOSE 8002
CMD ["uvicorn", "app.services.osv_worker:app", "--host", "0.0.0.0", "--port", "8002"]
