# Copy to .env.production and replace every example value.
APP_ENV=production
POSTGRES_DB=vulnscan
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://vulnscan:URL_ENCODED_PASSWORD@db:5432/vulnscan
CORS_ORIGINS=["https://vulnscan.example.com"]
FRONTEND_URL=https://vulnscan.example.com
SMTP_HOST=smtp-proxy
SMTP_PORT=2525
SMTP_UPSTREAM_HOST=smtp.your-provider.example
SMTP_UPSTREAM_PORT=587
SMTP_TLS_SERVER_NAME=smtp.your-provider.example
SMTP_PROXY_MAX_CONNECTIONS=20
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
MAX_UPLOAD_MB=25
MAX_ARCHIVE_FILES=3000
MAX_EXTRACTED_MB=100
SCANNER_WORKER_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
OPS_ADMIN_TOKEN=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
DEAD_LETTER_ARCHIVE_RETENTION_HOURS=72
MONTHLY_ANALYSIS_LIMIT=30
MAX_CONCURRENT_ANALYSES=2
MFA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_AND_KEEP_IT_SECRET

MAX_QUEUED_STORAGE_MB=50
ANALYSIS_JOB_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180

BACKUP_RECIPIENT=age1replace_with_your_public_recipient
# Optional rclone destination, e.g. remote:vulnscan/backups. Configure rclone on the host first.
BACKUP_REMOTE=
BACKUP_LOCAL_RETENTION_DAYS=14
