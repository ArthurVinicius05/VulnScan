# Copy to .env.production and replace every example value.
APP_ENV=production
POSTGRES_DB=vulnscan
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://vulnscan:URL_ENCODED_PASSWORD@db:5432/vulnscan
CORS_ORIGINS=["https://vulnscan.example.com"]
FRONTEND_URL=https://vulnscan.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
MAX_UPLOAD_MB=25
MAX_ARCHIVE_FILES=3000
MAX_EXTRACTED_MB=100
